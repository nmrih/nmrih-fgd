		1 : "Yes"
	]

	font(string) : "Font" : "PointMessageDefault" : "Which font to use? (from ClientScheme.res) Examples: \nDebugFixedSmall - classic\nPointMessageDefault - fancy"
	fontproportional(choices) : "Proportional Font" : 1 : "If set, the text will scale to user resolution." =
	[
		0 : "No"
		1 : "Yes"
	]
	fontdropshadow(choices) : "Enable Drop Shadow" : 1 : "If set, the font will have a drop shadow." =
	[
		0 : "No"
		1 : "Yes"
	]
	offsetposition(choices) : "Offset Message Position" : 1 : "If set, text position will be offset relative to entity bounds. Works best when following parented entities. Select 'No' for entity origin." =
	[
		0 : "No"
		1 : "Yes"
	]

	heightoffset(float) : "Offset Position Height" : "0.5" : "When Offset Message Position is set, this allows you to set message offset relative to entity bounds. For example, 0.5 would print at the center of the hull, while 1.25 prints slightly over the top."

	color(color255) : "Text Color" : "255 255 255"

	// Inputs
