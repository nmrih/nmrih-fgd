@PointClass base(Targetname, Angles, Origin, BaseItem) studioprop() = item_custom: "A carryable item with custom properties." 
[
	spawnflags(Flags) =
	[
		2 : "Remove on Apply" : 0
	]
	
	model(studio) : "Model" : "" : "Sets a model for this item."
	
	// Workaround for a Hammer "feature", model selector always sets the skin value
	skin(integer) : "Skin" : 0
	
	label(string) : "Label" : "" : "Sets visible name for inventory, accepts localization strings."
	icon(material) : "Inventory Icon" : "" : "Material name for VGUI inventory icon."
	weight(float) : "Weight" : "50" : "Item physical weight."
	highlight(choices) : "Is Highlighted?" : 1 : "Highlight entry in the inventory?" =
	[
		0 : "No"
		1 : "Yes"
	]
	hoverselect(choices) : "Apply by Mouse Hover?" : 0 : "Can this item be applied by hovering over its entry and closing the radial wheel? When 'No', user must click to apply." =
	[
		0 : "No"
		1 : "Yes"
	]
	
	// Outputs
	output OnPlayerApply(void) : "Fired when this item is applied by a player (i.e. clicked in the inventory wheel)."
]

